{
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs"
    }
  },
  "compilerOptions": {
    "target": "ES2020",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "preserve",
    "allowJs": false,
    "noImplicitThis": false,
    "noUnusedLocals": false,
    "noUnusedParameters": true,
    "lib": [
      "ES2019",
      "DOM"
    ]
  },
  "include": [
    "active-users/**/*.ts",
    "adapters/**/*.ts",
    "aggregator-derivatives/**/*.ts",
    "aggregator-options/**/*.ts",
    "aggregators/**/*.ts",
    "bridge-aggregators/**/*.ts",
    "dexs/**/*.ts",
    "factory/**/*.ts",
    "fees/**/*.ts",
    "helpers/**/*.ts",
    "incentives/**/*.ts",
    "normalized-volume/**/*.ts",
    "open-interest/**/*.ts",
    "options/**/*.ts",
    "protocols/**/*.ts",
    "users/**/*.ts",
    "utils/**/*.ts"
  ],
}